    "demo": "playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.80.2",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.1.8",
    "@types/node": "22.15.29",
    "@types/react": "19.0.14",
    "@types/react-dom": "19.0.6",
    "@vitejs/plugin-react": "4.5.1",
    "tailwindcss": "4.1.8",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "5.1.2"
  }
}
